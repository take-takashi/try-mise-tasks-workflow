# MDW共通の設定既定値です。APIキーなどの秘密情報は記載しないでください。
# MDW_DEFAULT_MODEL を未指定にすると、各 AI CLI 側の既定モデルを使います。
MDW_DEFAULT_PROVIDER=agy
# MDW_DEFAULT_MODEL=
MDW_DEFAULT_EFFORT=medium
MDW_DEFAULT_BILLING=subscription

# レビュー系はクォータ分散とクロスチェックを兼ねてモデルを分けます（quality / judge は既定の Gemini、security は Claude）。
MDW_REVIEW_MODEL=gemini-4-neon-medium
MDW_REVIEW_SECURITY_MODEL=claude-opus-5-5-medium

# worktree のブランチ名生成は軽量モデルを使用します。
MDW_WORKTREE_MODEL=gemini-3.8-flash-low
